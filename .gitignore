# ==============================================================================
# Gitignore configuration for MediMei Project
# ==============================================================================

# --- System & IDEs ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Environment & Secret Files ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.env

# --- Local ML Models & Large Weights ---
*.gguf
*.safetensors
*.bin
*.pt
*.onnx
data/models/
/models/
.paddleocr/
.cache/

references/

# --- Local Uploads & Data Artifacts ---
data/uploads/*
!data/uploads/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/test_documents/*
!data/test_documents/.gitkeep

# --- Python Backend Dependencies & Caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
*.log
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/
build/
dist/
*.egg-info/

# --- Frontend Node.js Dependencies & Build ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
frontend/dist/
frontend/build/
.eslintcache
.parcel-cache
.cache/

# --- Database & Storage Mock files ---
*.db
*.sqlite
*.sqlite3
mysql-data/
qdrant-storage/

backup/