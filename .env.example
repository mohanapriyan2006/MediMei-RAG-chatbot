# LabelProof Environment Configuration
APP_NAME=LabelProof
ENVIRONMENT=development

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///./labelproof.db
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=labelproof
# MYSQL_USER=root
# MYSQL_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=supersecretkeychangeinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Qdrant Vector Search Settings
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=drug_documents

# Embedding & LLM Settings
EMBEDDING_MODEL=BAAI/bge-m3
LLM_MODEL=Qwen/Qwen3.5-4B
LLM_MODEL_PATH=data/models/llm/qwen-3.5-4B-Q4_K_M.gguf
